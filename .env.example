# =============================================================================
# PHOENIXX SMARTBUILD — environment variables
# Copy to .env.local for development, set the same keys in the hosting
# provider's dashboard for production. Never commit a filled-in .env file.
# Setup steps for each block: docs/INTEGRATIONS.md
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://phoenixxglobal.com

# --- Analytics (Phase 4 Batch D) --------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Server-side generate_lead via GA4 Measurement Protocol.
GA4_API_SECRET=

# --- Integration switches ---------------------------------------------------
# Each adapter stays off until its flag is "true" AND its credentials are set.
INTEGRATION_SHEETS_ENABLED=false
INTEGRATION_EMAIL_ENABLED=false
INTEGRATION_ALERT_ENABLED=false
INTEGRATION_WHATSAPP_ENABLED=false
INTEGRATION_CRM_ENABLED=false
INTEGRATION_WEBHOOK_ENABLED=false

# --- Google Sheets ledger (permanent record — enable this first) ------------
# Service-account email from the Google Cloud JSON key.
GOOGLE_SHEETS_CLIENT_EMAIL=
# Private key from the same JSON, newlines escaped as \n, wrapped in quotes.
GOOGLE_SHEETS_PRIVATE_KEY=
# The long id in the sheet URL between /d/ and /edit.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Leads

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend, or auto-replies land in spam.
LEAD_FROM_EMAIL=
LEAD_REPLY_TO_EMAIL=
# Internal recipients for the lead brief, comma-separated.
LEAD_NOTIFY_EMAIL=

# --- WhatsApp Cloud API (needs Meta template approval) ----------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Sales number that receives internal alerts, E.164 without the +.
WHATSAPP_SALES_NUMBER=
# Approved template names — leave blank until Meta approves them.
WHATSAPP_ACK_TEMPLATE=
WHATSAPP_ALERT_TEMPLATE=

# --- CRM (optional — Sheets carries the workflow until this is set) ---------
# "zoho" or "hubspot".
CRM_PROVIDER=
CRM_API_KEY=
CRM_PIPELINE_ID=
# Zoho only.
CRM_REFRESH_TOKEN=
CRM_CLIENT_ID=
CRM_CLIENT_SECRET=
CRM_ACCOUNTS_URL=https://accounts.zoho.in
CRM_API_DOMAIN=https://www.zohoapis.in

# --- Generic webhook (n8n / Make / Zapier) ----------------------------------
LEAD_WEBHOOK_URL=
# Shared secret used to sign the payload (HMAC SHA-256, X-PSB-Signature header).
LEAD_WEBHOOK_SECRET=

# --- Internal alerting ------------------------------------------------------
# Optional Telegram fallback for dead-letter alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret required by the follow-up, SLA and digest cron endpoints.
CRON_SECRET=
